{
  "name": "@sethyrung/portfolio",
  "version": "1.1.0",
  "description": "Terminal portfolio for Sethy Rung: a Dev Card by default, other Screens on demand",
  "keywords": [
    "cli",
    "portfolio"
  ],
  "homepage": "https://sethyrung.com",
  "license": "MIT",
  "author": {
    "name": "Sethy Rung",
    "url": "https://sethyrung.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SethyRung/portfolio-cli.git"
  },
  "bin": {
    "sethyrung": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/main.ts --target=node --outfile=dist/cli.js --packages=external",
    "compile": "bun build --compile --asset src/content src/main.ts --outfile sethyrung",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@comark/ansi": "^0.7.0",
    "comark": "^0.7.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=18"
  }
}
