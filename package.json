{
  "name": "@sethyrung/portfolio",
  "version": "1.0.0",
  "description": "Interactive terminal Dev Card for Sethy Rung",
  "keywords": [
    "cli",
    "devcard",
    "opentui",
    "portfolio",
    "tui"
  ],
  "homepage": "https://sethyrung.com",
  "license": "MIT",
  "author": {
    "name": "Sethy Rung",
    "url": "https://sethyrung.com"
  },
  "bin": {
    "sethyrung": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "start": "bun src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "bun test && bun run typecheck && bun run lint && bun run fmt:check"
  },
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "@opentui/react": "^0.5.10",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "@types/react": "^19.2.18",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
